---
/**
 * Perspektiven als weisse Blätter auf Pflaume (im Sockel): bis zu drei,
 * das erste und das dritte leicht gedreht. Datum Coral in Versalien
 * (Regel 6: Coral im Sockel nur als Knopf und als Datum auf den Blättern),
 * Titel in Serif. Unter 860 px einspaltig und ohne Drehung.
 */
interface Props {
  items: Array<{ href: string; title: string; text: string; date?: Date }>;
}

const { items } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString('de-CH', { year: 'numeric', month: 'short', day: 'numeric' });
---

{items.length > 0 && (
  <ul class="blaetter">
    {items.slice(0, 3).map(item => (
      <li>
        <a href={item.href} class="blatt">
          {item.date && <time class="blatt-datum" datetime={item.date.toISOString().split('T')[0]}>{formatDate(item.date)}</time>}
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .blaetter {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blaetter li {
    margin: 0;
  }

  .blatt {
    display: block;
    height: 100%;
    padding: 28px 28px 32px;
    color: var(--color-ink);
    text-decoration: none;
    background: var(--color-white);
    border-radius: var(--radius-cut);
    box-shadow: var(--shadow-sheet);
    --heading: var(--color-plum);
  }

  .blaetter li:nth-child(1) .blatt {
    transform: rotate(-0.8deg);
  }

  .blaetter li:nth-child(3) .blatt {
    transform: rotate(0.7deg);
  }

  .blatt-datum {
    display: block;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-coral);
  }

  .blatt h3 {
    margin: 14px 0 10px;
    font-size: 32px;
    line-height: 1.05;
  }

  .blatt:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--color-coral);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .blatt p {
    margin: 0;
    font-size: 15.5px;
    color: var(--color-plum-soft);
  }

  @media (max-width: 860px) {
    .blaetter {
      grid-template-columns: 1fr;
    }

    .blaetter li:nth-child(n) .blatt {
      transform: none;
    }

    .blatt h3 {
      font-size: 28px;
    }
  }
</style>

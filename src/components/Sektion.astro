---
/**
 * Eine Sektion aus PageContent, einspaltig in --page-width mit der H2 in
 * Serif (ersetzt das Ben-Evans-Raster mit Label-Spalte, Redesign 2026-11).
 * Markdown-Kanal (to-markdown.ts) und JSON-LD (structured-data.ts) lesen
 * dieselben Daten und bleiben unberührt.
 *
 * Zwei Sektions-IDs tragen Bedeutung (siehe types.ts):
 * - `formate`: Items mit Titel werden Format-Karten in Rosé-hell, die Dauer
 *   (`tag`) in Serif kursiv Coral ab 24 px (Regel 3).
 * - `faq`: Fragen als <details> mit einem Plus in Coral, ohne JS.
 */
import Figure from './Figure.astro';
import Karte from './Karte.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import RichText from './RichText.astro';
import type { Item, Section, TextItem } from '../data/pages/types';

interface Props {
  section: Section;
}

const { section } = Astro.props;

// Aufeinanderfolgende Formate stehen gemeinsam in einem Raster; alles
// andere (ein Diagramm, ein Schlusssatz) läuft dazwischen in der Spalte.
type Block = { kind: 'formate'; items: TextItem[] } | { kind: 'single'; item: Item };
const isFormat = (item: Item): item is TextItem =>
  section.id === 'formate' && item.kind === 'item' && Boolean(item.title);
const blocks: Block[] = [];
for (const item of section.items) {
  const last = blocks.at(-1);
  if (isFormat(item) && last?.kind === 'formate') last.items.push(item);
  else if (isFormat(item)) blocks.push({ kind: 'formate', items: [item] });
  else blocks.push({ kind: 'single', item });
}

const target = (external?: boolean) => (external ? '_blank' : undefined);
const rel = (external?: boolean) => (external ? 'noopener' : undefined);
---

<section class="sektion" id={section.id}>
  <h2>{section.label}</h2>
  {blocks.map(block => {
    if (block.kind === 'formate') {
      return (
        <div class:list={['format-raster', { einzeln: block.items.length === 1 }]}>
          {block.items.map(item => (
            <Karte tone="blush-light" class="format">
              {item.tag && <span class="dauer">{item.tag}</span>}
              <h3>{item.title}</h3>
              <p><RichText value={item.body} /></p>
              {item.cta && (
                <a href={item.cta.href} class="cta-link" target={target(item.cta.external)} rel={rel(item.cta.external)}>
                  {item.cta.label}{item.cta.arrow && <> &rarr;</>}
                </a>
              )}
            </Karte>
          ))}
        </div>
      );
    }

    const item = block.item;

    if (item.kind === 'person') {
      return (
        <div class="person" id={item.anchor}>
          <img src={item.image} alt={item.name} class="person-bild" loading="lazy" decoding="async" />
          <div class="person-text">
            <h3>{item.name}</h3>
            <span class="etikett">{item.tag}</span>
            <p><RichText value={item.body} /></p>
            {item.links.length > 0 && (
              <p class="person-links">
                {item.links.map(l => (
                  <a href={l.href} target={target(l.external)} rel={rel(l.external)}>{l.label}</a>
                ))}
              </p>
            )}
          </div>
        </div>
      );
    }

    if (item.kind === 'logos') {
      return (
        <div class="logos">
          {item.entries.map(entry => (
            <figure class="logo">
              <img src={entry.image} alt={`Logo ${entry.name}`} loading="lazy" decoding="async" />
              <figcaption>{entry.note}</figcaption>
            </figure>
          ))}
        </div>
      );
    }

    if (item.kind === 'links') {
      return (
        <ul class="themen">
          {item.entries.map(entry => (
            <li>
              <Karte tone="blush-light" href={entry.href} class="thema">
                <h3>{entry.title}</h3>
                <p>{entry.teaser}</p>
              </Karte>
            </li>
          ))}
        </ul>
      );
    }

    if (item.kind === 'quote') {
      return (
        <figure class="zitat">
          <blockquote>&laquo;{item.text}&raquo;</blockquote>
          <figcaption>{item.cite}</figcaption>
        </figure>
      );
    }

    // Diagramme stehen frei auf Weiss, ein Klick öffnet sie in voller Grösse.
    if (item.kind === 'image') {
      return <Figure figure={item} class="sektion-figur" />;
    }

    // FAQ: sichtbar sind die Fragen, die Antwort öffnet sich auf Klick.
    // Natives <details>: kein JS, per Tastatur bedienbar, Antwort im HTML.
    if (section.id === 'faq' && item.kind === 'item' && item.title) {
      return (
        <details class="faq">
          <summary>
            <span class="faq-frage">
              {item.tag && <span class="etikett">{item.tag}</span>}
              <h3>{item.title}</h3>
            </span>
            <span class="faq-plus" aria-hidden="true"></span>
          </summary>
          <div class="faq-antwort">
            <p><RichText value={item.body} /></p>
            {item.cta && (
              <a href={item.cta.href} class="cta-link" target={target(item.cta.external)} rel={rel(item.cta.external)}>
                {item.cta.label}{item.cta.arrow && <> &rarr;</>}
              </a>
            )}
            {item.component?.name === 'newsletter' && <NewsletterSignup />}
          </div>
        </details>
      );
    }

    // Items ohne Tag und Titel sind Fliesstext-Absätze und rücken enger
    // zusammen als eigenständige Einträge.
    return (
      <div class:list={['eintrag', { prosa: !item.tag && !item.title }]}>
        {item.tag && <span class="etikett">{item.tag}</span>}
        {item.title && <h3>{item.title}</h3>}
        <p><RichText value={item.body} /></p>
        {item.cta && (
          <a href={item.cta.href} class="cta-link" target={target(item.cta.external)} rel={rel(item.cta.external)}>
            {item.cta.label}{item.cta.arrow && <> &rarr;</>}
          </a>
        )}
        {item.component?.name === 'newsletter' && <NewsletterSignup />}
      </div>
    );
  })}
</section>

<style>
  .sektion {
    max-width: var(--page-width);
    margin: var(--space-xl) 0;
  }

  .sektion > h2 {
    margin: 0 0 var(--space-lg);
    font-size: 44px;
    line-height: 1.05;
  }

  .sektion h3 {
    margin: 0 0 var(--space-sm);
    font-size: 28px;
    line-height: 1.15;
  }

  .sektion p {
    margin: 0;
  }

  /* Etikett: Versalien, 13 px, Pflaume-soft */
  .etikett {
    display: block;
    margin-bottom: var(--space-xs);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-plum-soft);
  }

  .eintrag {
    margin-bottom: var(--space-lg);
  }

  .eintrag:last-child {
    margin-bottom: 0;
  }

  .eintrag.prosa:has(+ .eintrag.prosa) {
    margin-bottom: var(--space-md);
  }

  .cta-link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 15px;
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  /* Formate: Papierkarten, bei mehreren in zwei Spalten */
  .format-raster {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: var(--space-lg);
  }

  .format-raster.einzeln {
    grid-template-columns: minmax(0, 1fr);
  }

  .format-raster:last-child {
    margin-bottom: 0;
  }

  .dauer {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-serif);
    font-size: 26px;
    font-style: italic;
    line-height: 1.1;
    color: var(--color-coral);
  }

  .format-raster p {
    font-size: 15.5px;
    color: var(--color-plum-soft);
  }

  /* Leistungen: Themen-Karten in Rosé-hell */
  .themen {
    display: grid;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .themen li {
    margin: 0;
  }

  .themen h3 {
    font-size: 34px;
    line-height: 1.05;
  }

  .themen p {
    color: var(--color-plum-soft);
  }

  /* Personen: rundes Foto, daneben Name, Rolle, Text, Links */
  .person {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    margin-bottom: var(--space-xl);
  }

  .person:last-child {
    margin-bottom: 0;
  }

  .person-bild {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
  }

  .person-text {
    flex: 1;
    min-width: 0;
  }

  .person-text .etikett {
    margin-bottom: var(--space-sm);
  }

  .person-text .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-sm);
    font-size: 15px;
    font-weight: 600;
  }

  /* Zitat: gross in Serif kursiv, Quelle in Versalien */
  .zitat {
    margin: var(--space-xl) 0;
  }

  .zitat:last-child {
    margin-bottom: 0;
  }

  .zitat blockquote {
    font-family: var(--font-serif);
    font-size: 30px;
    font-style: italic;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--color-plum);
  }

  .zitat figcaption {
    margin-top: var(--space-md);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-plum-soft);
  }

  /* Logos auf Weiss mit multiply. Der untere Abstand trennt die Reihe von
     einem folgenden Zitat, das sich sonst als Bildunterschrift liest. */
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .logo {
    margin: 0;
  }

  .logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 190px;
    max-height: 40px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .logo figcaption {
    margin-top: var(--space-sm);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-plum-soft);
  }

  .sektion :global(.sektion-figur) {
    margin: var(--space-lg) 0;
  }

  /* FAQ: Haarlinie in Rosé zwischen den Fragen, Plus in Coral rechts */
  .faq {
    border-top: 1px solid var(--color-blush);
  }

  .faq:last-child {
    border-bottom: 1px solid var(--color-blush);
  }

  .faq summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 18px 0;
    list-style: none;
    cursor: pointer;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
  }

  .faq summary:hover h3 {
    color: var(--color-coral);
  }

  .faq-plus {
    position: relative;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 6px;
  }

  .faq-plus::before,
  .faq-plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background: var(--color-coral);
    transition: transform 0.15s ease;
  }

  .faq-plus::after {
    transform: rotate(90deg);
  }

  .faq[open] .faq-plus::after {
    transform: rotate(0deg);
  }

  .faq-antwort {
    padding: 0 calc(18px + var(--space-md)) 22px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-plus::before,
    .faq-plus::after {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .sektion > h2 {
      font-size: 36px;
    }

    .format-raster {
      grid-template-columns: minmax(0, 1fr);
    }

    .person {
      flex-direction: column;
      gap: var(--space-md);
    }

    .zitat blockquote {
      font-size: 24px;
    }

    .faq h3 {
      font-size: 21px;
    }
  }
</style>

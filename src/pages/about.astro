---
import BaseLayout from '../layouts/BaseLayout.astro';
import { jsonLd } from '../lib/json-ld';
import EvansSection from '../components/EvansSection.astro';
import PageIntro from '../components/PageIntro.astro';
import { about } from '../data/pages/about';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jochen Witte',
  url: 'https://fumu.ch/about/',
  image: 'https://fumu.ch/images/jochen-witte.jpg',
  jobTitle: 'Strategieberater für KI-Transformation in Medien, Marketing und Werbung',
  description: 'Strategieberater an der Schnittstelle von Strategie, Organisation, Prozessen und Technologie. 20+ Jahre Digital. Startup-Gründer, Technologie-Chef in Medienhäusern, Strategieberater. Systemische Ausbildung.',
  worksFor: {
    '@type': 'Organization',
    name: 'fumu',
    url: 'https://fumu.ch',
  },
  sameAs: ['https://www.linkedin.com/in/jochenwitte/'],
  knowsAbout: [
    'KI-Transformation',
    'Digitale Transformation',
    'Geschäftsmodell-Innovation',
    'Tech-Strategie',
    'Organisationsentwicklung',
    'Prozess-Architektur',
    'Datenstrategie',
    'Künstliche Intelligenz',
    'KI-Integration',
    'AdTech',
    'MarTech',
    'Programmatic Advertising',
    'Publisher-Strategie',
  ],
  knowsLanguage: ['de', 'en'],
};
---

<BaseLayout title={about.title} description={about.description}>

  <script type="application/ld+json" set:html={jsonLd(personLd)} />

  <section class="evans-page">
    <div class="container">

      <h1>{about.title}</h1>

      <PageIntro paragraphs={about.intro} />

      {about.sections.map(section => (
        <>
          <hr class="section-divider" />
          <EvansSection section={section} />
        </>
      ))}

    </div>
  </section>

</BaseLayout>

<style>
  .section-divider {
    border: none;
    border-top: 1px solid var(--color-coral);
    margin: 0;
  }
</style>

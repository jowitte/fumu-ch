---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvansSection from '../components/EvansSection.astro';
import { kontakt } from '../data/pages/kontakt';
---

<BaseLayout title={kontakt.title} description={kontakt.description}>

  <section class="evans-page">
    <div class="container">

      <h1>{kontakt.title}</h1>

      <p class="intro">{kontakt.intro}</p>

      {kontakt.sections.map(section => (
        <>
          <hr class="section-divider" />
          <EvansSection section={section} sticky={false} />
        </>
      ))}

    </div>
  </section>

</BaseLayout>

<style>
  .intro {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 720px;
    margin: 0 0 var(--space-xl) 0;
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--color-coral);
    margin: 0;
  }

  @media (max-width: 768px) {
    .intro {
      font-size: 18px;
      margin: 0 0 var(--space-lg) 0;
    }
  }
</style>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Karte from '../../components/Karte.astro';
import PerspektivenBlaetter from '../../components/PerspektivenBlaetter.astro';
import { resolveAuthors, getAuthorUrl } from '../../content/authors';
import { getSeries } from '../../data/series';
import { isPublished, isScheduled } from '../../lib/published';
import { readingMinutes } from '../../lib/reading-time';
import { sockelPerspektiven } from '../../lib/sockel';

export async function getStaticPaths() {
  const posts = await getCollection('perspektiven', isPublished);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('de-CH', { year: 'numeric', month: 'short', day: 'numeric' }).toUpperCase();
};

const postAuthors = resolveAuthors(post.data.authors);

// Geplantes Stück: nur der Dev-Server zeigt es (Lokal-Review), der Build nie.
const scheduled = import.meta.env.DEV && isScheduled(post);

// Themen-Kontext: Streifen im Kopf, Vor/Zurück nur bei erzähltem Bogen
// (seriesPart gesetzt), im Sockel weitere Perspektiven desselben Themas.
const seriesSlug = post.data.series;
const seriesData = getSeries(seriesSlug);
const seriesHref = seriesSlug ? `/perspektiven/themen/${seriesSlug}/` : undefined;
let prevPost: typeof post | null = null;
let nextPost: typeof post | null = null;
if (seriesSlug && seriesData && post.data.seriesPart) {
  const seriesParts = (await getCollection('perspektiven', (entry) => isPublished(entry) && entry.data.series === seriesSlug && entry.data.seriesPart != null))
    .sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0));
  const idx = seriesParts.findIndex(p => p.id === post.id);
  prevPost = idx > 0 ? seriesParts[idx - 1] : null;
  nextPost = idx >= 0 && idx < seriesParts.length - 1 ? seriesParts[idx + 1] : null;
}

// Sockel: bis zu drei weitere Perspektiven desselben Themas, sonst die neuesten.
const toBlatt = (entry: typeof post) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  series: entry.data.series,
});
const allPosts = (await getCollection('perspektiven', isPublished)).map(toBlatt);
const blaetter = sockelPerspektiven(allPosts, toBlatt(post));
---

<BaseLayout title={post.data.title} description={post.data.description} article={{ title: post.data.title, description: post.data.description, date: post.data.date, updated: post.data.updated, image: post.data.image, slug: post.id, authors: postAuthors }}>
  <article class="container artikel">
    <header class="artikel-kopf">
      {scheduled && (
        <p class="scheduled-hint">Geplant für {formatDate(post.data.date)}, nur lokal sichtbar</p>
      )}
      <div class="meta">
        <time class="meta-datum" datetime={post.data.date.toISOString().split('T')[0]}>{formatDate(post.data.date)}</time>
        {seriesData && seriesHref && (
          <a href={seriesHref} class="meta-thema">
            {post.data.seriesPart
              ? <>Teil {post.data.seriesPart} im Thema {seriesData.name}</>
              : <>Thema: {seriesData.name}</>}
          </a>
        )}
        <span class="meta-autor">
          {postAuthors.map((author, i) => (
            <>
              {i > 0 && (i === postAuthors.length - 1 ? ' und ' : ', ')}
              <a href={getAuthorUrl(author.slug)}>{author.name}</a>
            </>
          ))}
        </span>
        <span>{readingMinutes(post.body)} Min.</span>
        {post.data.updated && (
          <span>Überarbeitet {formatDate(post.data.updated)}</span>
        )}
      </div>
      <h1 class="post-title">{post.data.title}</h1>
    </header>

    <div class="post-body">
      <Content />
    </div>

    {seriesData && (prevPost || nextPost) && (
      <nav class="series-nav" aria-label={`Navigation innerhalb des Themas ${seriesData.name}`}>
        {prevPost ? (
          <Karte tone="blush-light" href={`/perspektiven/${prevPost.id}/`} class="series-nav-link">
            <span class="series-nav-dir">&larr; Vorheriger Teil</span>
            <span class="series-nav-title">{prevPost.data.title}</span>
          </Karte>
        ) : <span class="series-nav-spacer"></span>}
        {nextPost ? (
          <Karte tone="blush-light" href={`/perspektiven/${nextPost.id}/`} class="series-nav-link series-nav-next">
            <span class="series-nav-dir">Nächster Teil &rarr;</span>
            <span class="series-nav-title">{nextPost.data.title}</span>
          </Karte>
        ) : <span class="series-nav-spacer"></span>}
      </nav>
    )}

    <Karte tone="blush-light" class="post-newsletter">
      <p class="post-newsletter-text">Perspektiven wie diese – gelegentlich per E-Mail.</p>
      <a href="/kontakt/#newsletter" class="post-newsletter-link">Newsletter abonnieren &rarr;</a>
    </Karte>
  </article>

  <section slot="sockel" class="mehr" aria-labelledby="mehr-titel">
    <div class="sec-head">
      {seriesData && seriesHref ? (
        <>
          <h2 id="mehr-titel">Mehr aus dem Thema {seriesData.name}</h2>
          <a href={seriesHref} class="sec-link">Zum Thema</a>
        </>
      ) : (
        <>
          <h2 id="mehr-titel">Perspektiven</h2>
          <a href="/perspektiven/" class="sec-link">Alle Perspektiven</a>
        </>
      )}
    </div>
    <PerspektivenBlaetter
      items={blaetter.map(entry => ({
        href: `/perspektiven/${entry.id}/`,
        title: entry.title,
        text: entry.description,
        date: entry.date,
      }))}
    />
    <a href="/perspektiven/" class="zurueck">&larr; Alle Perspektiven</a>
  </section>
</BaseLayout>

<style>
  /* Kopf und Text in der Lesespalte (--read-width), mittig. */
  .artikel-kopf {
    max-width: var(--read-width);
    margin: 48px auto 0;
  }

  .scheduled-hint {
    display: inline-block;
    margin-bottom: var(--space-md);
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-plum);
    border-radius: var(--radius-cut);
  }

  /* Meta-Zeile: Datum Coral, Thema als Papierstreifen in Rosé, Rest Pflaume-soft */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-plum-soft);
  }

  .meta-datum {
    color: var(--color-coral);
  }

  .meta-thema {
    padding: 8px 12px;
    font-size: 14px;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: none;
    color: var(--color-plum);
    background: var(--color-blush);
    border-radius: var(--radius-cut);
  }

  .meta-thema:hover {
    text-decoration: underline;
  }

  .meta-autor a {
    color: inherit;
    text-decoration: none;
  }

  .meta-autor a:hover {
    text-decoration: underline;
  }

  .post-title {
    max-width: 12em;
    margin: 26px 0 0;
  }

  /* Lesetext */
  .post-body {
    max-width: var(--read-width);
    margin: 48px auto 0;
    font-size: 18.5px;
    line-height: 1.72;
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: 1.1em;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.3em;
  }

  .post-body :global(li) {
    margin-bottom: 0.3em;
  }

  .post-body :global(h2) {
    margin: 1.6em 0 0.5em;
    font-size: 38px;
    line-height: 1.1;
  }

  .post-body :global(hr) {
    margin: 2em 0;
    border: none;
    border-top: 1px solid var(--color-blush);
  }

  /* Die Ebene der Vergrösserung (global.css) bringt eigene Masse mit. */
  .post-body :global(img:not(.zoom-layer img)) {
    max-width: 100%;
    height: auto;
  }

  /* Detail-Bilder (rehype-img-zoom) stehen frei in der Spalte. */
  .post-body :global(.post-figure) {
    margin: 2em 0;
  }

  /* Der Knopf so breit wie das Bild, damit der Hinweis in dessen Ecke sitzt. */
  .post-body :global(.post-figure .figure-zoom) {
    width: fit-content;
  }

  /* Illustrationen und Loop-Videos liegen auf Papier (global.css) und ragen
     links und rechts aus der Spalte. */
  .post-body :global(.loop-illustration),
  .post-body :global(p:has(> img[src*="-hero."]:only-child)) {
    margin: 2.2em -110px;
  }

  .post-body :global(p:has(> img[src*="-hero."]:only-child) > img) {
    width: 100%;
  }

  /* Serien-Navigation: zwei Karten nebeneinander */
  .series-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: var(--read-width);
    margin: 56px auto 0;
  }

  .series-nav :global(.series-nav-link) {
    padding: 20px 24px 22px;
  }

  .series-nav :global(.series-nav-next) {
    text-align: right;
  }

  .series-nav-dir {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-plum-soft);
  }

  .series-nav-title {
    display: block;
    margin-top: 6px;
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.15;
    color: var(--color-plum);
  }

  /* Newsletter-Hinweis als Karte in Rosé-hell */
  .artikel :global(.post-newsletter) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    max-width: var(--read-width);
    margin: 56px auto 0;
    padding: 26px 30px;
  }

  .post-newsletter-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.15;
    color: var(--color-plum);
  }

  .post-newsletter-link {
    font-size: 15px;
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  /* Sockel */
  .zurueck {
    display: inline-block;
    margin-top: 36px;
    text-underline-offset: 5px;
  }

  @media (max-width: 1000px) {
    .post-body :global(.loop-illustration),
    .post-body :global(p:has(> img[src*="-hero."]:only-child)) {
      margin: 2em -20px;
    }
  }

  @media (max-width: 860px) {
    .artikel-kopf {
      margin-top: var(--space-lg);
    }

    .post-body {
      margin-top: var(--space-lg);
      font-size: 17px;
    }

    .post-body :global(h2) {
      font-size: 30px;
    }

    .series-nav {
      grid-template-columns: 1fr;
    }

    .series-nav-spacer {
      display: none;
    }

    .series-nav :global(.series-nav-next) {
      text-align: left;
    }
  }
</style>

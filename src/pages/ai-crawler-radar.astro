---
import BaseLayout from "../layouts/BaseLayout.astro";
import { jsonLd } from "../lib/json-ld";
import BlockShareBars from "../components/charts/BlockShareBars.astro";
import TrendChart from "../components/charts/TrendChart.astro";
import CollapsibleSection from "../components/CollapsibleSection.astro";
import {
  tracker,
  intro,
  formatDate,
  getCategoryColor,
  describeRunChanges,
  renderInlineLinks,
  botTypeLabels,
  botTypeDescriptions,
  botTypeColors,
  LICENSE_URL,
  licenseNote,
} from "../data/crawler-tracker";

const description =
  "Welche AI-Crawler lassen gut 100 Sites in der robots.txt zu? Snapshot und Verlauf der fumu-Erhebung – alle 14 Tage, Schwerpunkt Schweiz.";

const categories = [...tracker.by_category].sort(
  (a, b) => b.block_share - a.block_share,
);
const crawlers = [...tracker.by_crawler].sort(
  (a, b) => b.block_share - a.block_share,
);

const categoryItems = categories.map((c) => ({
  label: c.label,
  share: c.block_share,
  detail: `${c.site_count} Sites`,
  color: getCategoryColor(c.category),
}));

const crawlerItems = crawlers.map((c) => ({
  label: c.label,
  share: c.block_share,
  detail: `${c.blocked_sites} von ${tracker.meta.site_count} Sites`,
  color: c.bot_category ? botTypeColors[c.bot_category] : undefined,
  sub: c.bot_category
    ? `${botTypeLabels[c.bot_category] ?? c.bot_category}${c.provider ? ` (${c.provider})` : ""}`
    : undefined,
  subTitle: c.bot_category ? botTypeDescriptions[c.bot_category] : undefined,
  marker: c.honors_robots === false ? "†" : undefined,
  markerTitle:
    c.honors_robots === false
      ? "Bindet sich nicht an robots.txt – die Blockade bleibt Deklaration."
      : undefined,
}));

// Legende nur für Typen, die im aktuellen Snapshot vorkommen.
const crawlerLegend = Object.entries(botTypeLabels)
  .filter(([type]) => crawlers.some((c) => c.bot_category === type))
  .map(([type, label]) => ({ label, color: botTypeColors[type] }));

// Lauf-Log: chronologisch absteigend, die jüngsten 6 offen, Rest klappbar.
const runs = [...(tracker.runs ?? [])].sort((a, b) =>
  b.date.localeCompare(a.date),
);
const OPEN_RUNS = 6;
const recentRuns = runs.slice(0, OPEN_RUNS);
const olderRuns = runs.slice(OPEN_RUNS);

// Site-Liste: nach Kategorie gruppiert, Reihenfolge wie die Kategorie-Balken.
const sites = tracker.sites ?? [];
const siteGroups = categories
  .map((c) => ({
    label: c.label,
    category: c.category,
    sites: sites
      .filter((s) => s.category === c.category)
      .sort((a, b) => a.name.localeCompare(b.name, "de")),
  }))
  .filter((g) => g.sites.length > 0);
// Sites mit Kategorien ausserhalb von by_category nicht still verschlucken.
const knownCategories = new Set(categories.map((c) => c.category));
const otherSites = sites.filter((s) => !knownCategories.has(s.category));
if (otherSites.length > 0) {
  siteGroups.push({
    label: "Weitere",
    category: "other",
    sites: [...otherSites].sort((a, b) => a.name.localeCompare(b.name, "de")),
  });
}

const methodologyDetails = tracker.methodology_details ?? [];

const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "fumu AI-Crawler-Radar",
  description,
  url: "https://fumu.ch/ai-crawler-radar/",
  inLanguage: "de-CH",
  creator: { "@type": "Organization", name: "fumu", url: "https://fumu.ch" },
  dateModified: tracker.meta.snapshot_date,
  temporalCoverage: `${tracker.trend[0].date}/${tracker.meta.snapshot_date}`,
  license: LICENSE_URL,
};
---

<BaseLayout title="AI-Crawler-Radar" description={description}>
  <script type="application/ld+json" set:html={jsonLd(datasetLd)} />

  <section class="radar-page">
    <div class="container">
      <div class="content">
        <h1>AI-Crawler-Radar</h1>

        <p class="snapshot-meta">
          Snapshot vom <strong>{formatDate(tracker.meta.snapshot_date)}</strong> ·{' '}
          {tracker.meta.site_count} Sites × {tracker.meta.crawler_count} Crawler ·
          Erhebung alle {tracker.meta.cadence_days} Tage
        </p>

        {
          intro.map((paragraph) => (
            <p class="intro" set:html={renderInlineLinks(paragraph)} />
          ))
        }

        <h2>Verlauf</h2>
        <p class="section-lead">
          Block-Anteil je Kategorie über die bisherigen Snapshots.
        </p>
        <TrendChart
          trend={tracker.trend}
          categories={categories}
          title="Verlauf des Block-Anteils je Kategorie seit April 2026"
        />

        {
          runs.length > 0 && (
            <section class="run-log">
              <h2>Aktualisierungen</h2>
              {recentRuns.map((run) => (
                <article class="run">
                  <p class="run-meta">
                    <strong>{formatDate(run.date)}</strong>
                    {describeRunChanges(run) && (
                      <> · {describeRunChanges(run)}</>
                    )}
                  </p>
                  <p
                    class="run-summary"
                    set:html={renderInlineLinks(run.summary)}
                  />
                  {run.commentary && (
                    <p
                      class="run-commentary"
                      set:html={renderInlineLinks(run.commentary)}
                    />
                  )}
                </article>
              ))}
              {olderRuns.length > 0 && (
                <details class="older-runs">
                  <summary>Ältere Läufe ({olderRuns.length})</summary>
                  {olderRuns.map((run) => (
                    <article class="run">
                      <p class="run-meta">
                        <strong>{formatDate(run.date)}</strong>
                        {describeRunChanges(run) && (
                          <> · {describeRunChanges(run)}</>
                        )}
                      </p>
                      <p
                        class="run-summary"
                        set:html={renderInlineLinks(run.summary)}
                      />
                      {run.commentary && (
                        <p
                          class="run-commentary"
                          set:html={renderInlineLinks(run.commentary)}
                        />
                      )}
                    </article>
                  ))}
                </details>
              )}
            </section>
          )
        }

        <div class="details-sections">
          <CollapsibleSection title="Block-Anteil nach Kategorie">
            <p class="section-lead">
              Anteil der Crawler-Site-Paare, die per robots.txt blockiert sind –
              je Site-Kategorie.
            </p>
            <BlockShareBars
              items={categoryItems}
              caption="Block-Anteil nach Site-Kategorie"
            />
          </CollapsibleSection>

          <CollapsibleSection title="Block-Anteil nach Crawler">
            <p class="section-lead">
              Anteil der {tracker.meta.site_count} Sites, die den jeweiligen Crawler
              blockieren.
            </p>
            <BlockShareBars
              items={crawlerItems}
              caption="Block-Anteil nach Crawler"
              monoLabels
              legend={crawlerLegend}
            />
            <p class="chart-footnote">
              † Bindet sich nicht an robots.txt (Anbieter-Doku bzw.
              Cloudflare-Forensik) – die Blockade bleibt Deklaration ohne
              Durchsetzung.
            </p>
          </CollapsibleSection>

          <CollapsibleSection title="Methodik">
            <ul class="methodology-notes">
              {tracker.methodology.map((note) => <li>{note}</li>)}
            </ul>
            {
              methodologyDetails.map((section) => (
                <section>
                  <h3>{section.title}</h3>
                  <p class="methodology-body">{section.body}</p>
                </section>
              ))
            }
          </CollapsibleSection>

          {
            siteGroups.length > 0 && (
              <CollapsibleSection title="Gemonitorte Sites">
                <p class="section-lead">
                  Das volle Sample der Erhebung, gruppiert nach Kategorie.
                </p>
                {siteGroups.map((group) => (
                  <section class="site-group">
                    <h3>
                      {group.label}{" "}
                      <span class="site-count">({group.sites.length})</span>
                    </h3>
                    <ul class="site-list">
                      {group.sites.map((site) => (
                        <li>
                          {site.name}{" "}
                          <span class="site-domain">{site.domain}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </CollapsibleSection>
            )
          }
        </div>

        <p class="license-note" set:html={renderInlineLinks(licenseNote)} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .radar-page {
    padding-bottom: var(--space-lg);
  }

  /* Snapshot-Zeile unter dem H1: Versalien, Pflaume-soft */
  .snapshot-meta {
    margin-bottom: var(--space-lg);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-plum-soft);
  }

  .snapshot-meta strong {
    color: var(--color-plum);
  }

  .intro {
    margin-bottom: var(--space-md);
    font-size: 17px;
    line-height: 1.65;
  }

  .content > h2 {
    margin-top: var(--space-xl);
  }

  /* Fuss der Seite, sichtbar ausserhalb der klappbaren Sections */
  .license-note {
    margin: var(--space-lg) 0 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-plum-soft);
  }

  .section-lead {
    margin-bottom: var(--space-md);
    font-size: 15px;
    color: var(--color-plum-soft);
  }

  .chart-footnote {
    margin-top: var(--space-md);
    font-size: 13px;
    color: var(--color-plum-soft);
  }

  .run {
    margin-bottom: var(--space-lg);
  }

  .run-meta {
    margin-bottom: var(--space-xs);
    font-size: 13px;
    color: var(--color-plum-soft);
  }

  .run-meta strong {
    color: var(--color-plum);
  }

  .run-summary {
    margin-bottom: var(--space-xs);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .run-commentary {
    margin-bottom: 0;
    padding-left: var(--space-md);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-plum-soft);
    border-left: 2px solid var(--color-blush);
  }

  .older-runs summary {
    margin-bottom: var(--space-md);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-plum-soft);
    cursor: pointer;
  }

  .older-runs summary:hover {
    color: var(--color-coral);
  }

  .details-sections {
    margin-top: var(--space-xl);
  }

  .details-sections :global(.collapsible:last-of-type) {
    border-bottom: 1px solid var(--color-blush);
  }

  .methodology-notes {
    padding-left: 1.25rem;
  }

  .methodology-notes li {
    margin-bottom: var(--space-sm);
    font-size: 15px;
    color: var(--color-plum-soft);
  }

  .methodology-body {
    font-size: 15px;
    line-height: 1.6;
  }

  .site-group h3 {
    margin-top: var(--space-md);
    font-size: 24px;
  }

  .site-count {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-plum-soft);
  }

  .site-list {
    list-style: none;
    padding: 0;
    columns: 2;
    column-gap: var(--space-lg);
  }

  .site-list li {
    margin-bottom: var(--space-xs);
    font-size: 15px;
    break-inside: avoid;
  }

  .site-domain {
    font-size: 13px;
    color: var(--color-plum-soft);
  }

  @media (max-width: 860px) {
    .site-list {
      columns: 1;
    }
  }
</style>

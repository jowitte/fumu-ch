---
/**
 * Lead unter dem H1 der Seiten aus PageContent (about, kontakt, Pillars).
 * Ein Eintrag pro Absatz; zwischen Absätzen der normale Absatzabstand, unter
 * dem Block der Abstand zur ersten Sektion.
 */
interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
---

<div class="intro">
  {paragraphs.map(paragraph => <p>{paragraph}</p>)}
</div>

<style>
  .intro {
    max-width: var(--page-width);
    margin: 0 0 var(--space-xl) 0;
  }

  .intro p {
    margin: 0 0 var(--space-md) 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-plum-soft);
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 860px) {
    .intro {
      margin: 0 0 var(--space-lg) 0;
    }

    .intro p {
      font-size: 18px;
    }
  }
</style>

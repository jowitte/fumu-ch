---
/**
 * WEGWERF-MOCKUP (was-wir-tun-grafisch, 2026-11-23): Diagramm zum Intro-Satz
 * im Excalidraw-Stil, von Hand nachgebaut. Die echte Fassung entstünde in
 * Excalidraw im Vault (wie das Organigramm der Pillar).
 *
 * Oben: Technologie allein – der Pfeil reisst ab, «Wirkung» bleibt grau.
 * Unten: Strategie, Organisation, Prozesse über Technologie – Coral-Pfeil
 * zur Wirkung.
 */

// Deterministische Unruhe wie bei Excalidraw (roughness 1)
const rng = (seed: number) => () => {
  seed |= 0;
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const rough = (x: number, y: number, w: number, h: number, seed: number, r = 8) => {
  const rand = rng(seed);
  const j = () => (rand() - 0.5) * 2.2;
  const p = [
    [x + r + j(), y + j()],
    [x + w - r + j(), y + j()],
    [x + w + j(), y + r + j()],
    [x + w + j(), y + h - r + j()],
    [x + w - r + j(), y + h + j()],
    [x + r + j(), y + h + j()],
    [x + j(), y + h - r + j()],
    [x + j(), y + r + j()],
  ];
  return (
    `M${p[0][0]} ${p[0][1]} L${p[1][0]} ${p[1][1]} Q${x + w} ${y} ${p[2][0]} ${p[2][1]} ` +
    `L${p[3][0]} ${p[3][1]} Q${x + w} ${y + h} ${p[4][0]} ${p[4][1]} L${p[5][0]} ${p[5][1]} ` +
    `Q${x} ${y + h} ${p[6][0]} ${p[6][1]} L${p[7][0]} ${p[7][1]} Q${x} ${y} ${p[0][0]} ${p[0][1]} Z`
  );
};

type Box = { x: number; y: number; w: number; h: number; label: string; ton: 'grau' | 'leer' | 'coral' };
const boxes: Box[] = [
  { x: 24, y: 56, w: 170, h: 48, label: 'Technologie', ton: 'grau' },
  { x: 446, y: 56, w: 130, h: 48, label: 'Wirkung', ton: 'leer' },
  { x: 24, y: 196, w: 104, h: 48, label: 'Strategie', ton: 'grau' },
  { x: 134, y: 196, w: 128, h: 48, label: 'Organisation', ton: 'grau' },
  { x: 268, y: 196, w: 100, h: 48, label: 'Prozesse', ton: 'grau' },
  { x: 24, y: 252, w: 344, h: 48, label: 'Technologie', ton: 'grau' },
  { x: 446, y: 224, w: 130, h: 48, label: 'Wirkung', ton: 'coral' },
];
const ink = '#1e1e1e';
const coral = '#C44540';
---

<svg class="ansatz-diagramm" viewBox="0 0 600 320" role="img" aria-label="Technologie allein bringt keine Wirkung. Erst zusammen mit Strategie, Organisation und Prozessen führt sie zur Wirkung.">
  <text x="24" y="36" class="t-titel">Technologie allein</text>

  {boxes.map((b, i) => (
    <g>
      <path
        d={rough(b.x, b.y, b.w, b.h, i + 11)}
        fill={b.ton === 'grau' ? '#eeeeee' : b.ton === 'coral' ? '#fdecea' : 'none'}
        stroke={b.ton === 'leer' ? '#b5b5b5' : b.ton === 'coral' ? coral : ink}
        stroke-width="1.4"
        stroke-dasharray={b.ton === 'leer' ? '6 5' : undefined}
      />
      {b.ton !== 'leer' && (
        <path d={rough(b.x, b.y, b.w, b.h, i + 101)} fill="none" stroke={b.ton === 'coral' ? coral : ink} stroke-width="0.8" opacity="0.6" />
      )}
      <text
        x={b.x + b.w / 2}
        y={b.y + b.h / 2 + 5}
        text-anchor="middle"
        class:list={['t-box', { 't-leer': b.ton === 'leer' }]}
      >{b.label}</text>
    </g>
  ))}

  <!-- Oben: Pfeil reisst ab -->
  <path d="M204 80 C 250 78, 290 82, 336 80" fill="none" stroke="#9a9a9a" stroke-width="1.6" stroke-dasharray="7 6" stroke-linecap="round" />

  <line x1="24" y1="140" x2="576" y2="140" stroke="#d6d6d6" stroke-width="1" />

  <text x="24" y="178" class="t-titel">mit Strategie, Organisation und Prozessen</text>

  <!-- Unten: Klammer und Coral-Pfeil zur Wirkung -->
  <path d="M378 200 C 386 202, 384 236, 392 248 C 384 260, 386 294, 378 298" fill="none" stroke={coral} stroke-width="1.8" stroke-linecap="round" />
  <path d="M394 248 C 410 247, 424 249, 438 248" fill="none" stroke={coral} stroke-width="2" stroke-linecap="round" />
  <path d="M428 240 L439 248 L428 256" fill="none" stroke={coral} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
</svg>

<style>
  .ansatz-diagramm {
    display: block;
    width: 100%;
    height: auto;
  }

  .t-titel {
    font-family: Excalifont, 'Comic Sans MS', cursive;
    font-size: 19px;
    fill: #1e1e1e;
  }

  .t-box {
    font-family: Excalifont, 'Comic Sans MS', cursive;
    font-size: 16.5px;
    fill: #1e1e1e;
  }

  .t-leer {
    fill: #9a9a9a;
  }
</style>

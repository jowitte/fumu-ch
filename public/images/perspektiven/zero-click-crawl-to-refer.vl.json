{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Gecrawlte Seiten pro zurückgeschicktem Besucher nach AI-Plattform, Q1 2026",
    "anchor": "start",
    "fontSize": 13,
    "fontWeight": "bold",
    "color": "#222",
    "offset": 14
  },
  "background": null,
  "width": 600,
  "height": 200,
  "data": {
    "values": [
      {
        "plattform": "Google",
        "wert": 5,
        "label": "5",
        "grp": "rest"
      },
      {
        "plattform": "Perplexity",
        "wert": 111,
        "label": "111",
        "grp": "rest"
      },
      {
        "plattform": "OpenAI",
        "wert": 1276,
        "label": "1'276",
        "grp": "rest"
      },
      {
        "plattform": "Anthropic",
        "wert": 23951,
        "label": "23'951",
        "grp": "hl"
      }
    ]
  },
  "encoding": {
    "y": {
      "field": "plattform",
      "type": "nominal",
      "sort": [
        "Google",
        "Perplexity",
        "OpenAI",
        "Anthropic"
      ],
      "axis": {
        "title": null,
        "labelFontSize": 13,
        "labelPadding": 8,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "wert",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "domain": [
          1,
          100000
        ]
      },
      "axis": {
        "title": "logarithmische Skala",
        "titleFontWeight": "normal",
        "titleColor": "#666666",
        "grid": false,
        "values": [
          1,
          10,
          100,
          1000,
          10000,
          100000
        ],
        "labelExpr": "datum.value >= 100000 ? \"100'000\" : datum.value >= 10000 ? \"10'000\" : datum.value >= 1000 ? \"1'000\" : datum.label",
        "labelOverlap": false,
        "format": "d"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopRight": 4,
        "cornerRadiusBottomRight": 4,
        "height": 28
      },
      "encoding": {
        "color": {
          "field": "grp",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "rest",
              "hl"
            ],
            "range": [
              "#BFBFBF",
              "#C44540"
            ]
          }
        },
        "x2": {
          "datum": 1
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 14,
        "fontWeight": 600,
        "color": "#222"
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
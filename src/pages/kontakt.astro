---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvansSection from '../components/EvansSection.astro';
import PageIntro from '../components/PageIntro.astro';
import { kontakt } from '../data/pages/kontakt';
---

<BaseLayout title={kontakt.title} description={kontakt.description}>

  <section class="evans-page">
    <div class="container">

      <h1>{kontakt.title}</h1>

      <PageIntro paragraphs={kontakt.intro} />

      {kontakt.sections.map(section => (
        <>
          <hr class="section-divider" />
          <EvansSection section={section} sticky={false} />
        </>
      ))}

    </div>
  </section>

</BaseLayout>

<style>
  .section-divider {
    border: none;
    border-top: 1px solid var(--color-coral);
    margin: 0;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvansSection from '../components/EvansSection.astro';
import { wasWirTun } from '../data/pages/was-wir-tun';

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'fumu',
  url: 'https://fumu.ch/was-wir-tun/',
  description: 'Beratung für KI-Transformation in Medien, Marketing und Werbung – an der Schnittstelle von Strategie, Organisation, Prozessen und Technologie, bis in die Umsetzung.',
  areaServed: { '@type': 'GeoShape', name: 'DACH' },
  serviceType: [
    'KI-Transformation',
    'Strategieberatung',
    'Digitale Transformation',
    'KI-Strategie und KI-Integration',
    'KI-Implementierung',
    'Tech-Strategie',
    'Organisationsentwicklung',
    'Prozess-Architektur',
    'Datenstrategie',
    'AdTech- und MarTech-Beratung',
    'Programmatic-Strategie',
    'Publisher-Beratung',
  ],
  provider: {
    '@type': 'Organization',
    name: 'fumu',
    url: 'https://fumu.ch',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Service-Formate',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Strategische Begleitung (8–16 Wochen)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Interim Leadership (6–18 Monate)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Sparring (laufend)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'KI-Schulungen und Workshops (1–5 Tage)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'KI-Implementierung (nach Vorhaben)' } },
    ],
  },
};
---

<BaseLayout title={wasWirTun.title} description={wasWirTun.description}>

  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />

  <section class="evans-page">
    <div class="container">

      <h1>{wasWirTun.title}</h1>

      <p class="intro">{wasWirTun.intro}</p>

      {wasWirTun.sections.map(section => (
        <>
          <hr class="section-divider" />
          <EvansSection section={section} />
        </>
      ))}

    </div>
  </section>

</BaseLayout>

<style>
  .intro {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 720px;
    margin: 0 0 var(--space-xl) 0;
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--color-coral);
    margin: 0;
  }

  @media (max-width: 768px) {
    .intro {
      font-size: 18px;
      margin: 0 0 var(--space-lg) 0;
    }
  }
</style>

---
/**
 * Bleistiftbild auf gerissenem Papier: eine Papierform in Rosé oder
 * Rosé-hell (clip-path aus `--torn-N`, src/lib/torn-paper.ts), optional ein
 * zweites Stück in Safran, darüber das Bild mit `mix-blend-mode: multiply` –
 * sein weisser Grund wird durchsichtig, die Striche liegen auf dem Papier.
 * Funktioniert mit jedem Bild auf weissem Grund (Bild-Stil `editorial`).
 *
 * Mit `video` spielt darüber ein stummes Loop-Video desselben Ausschnitts
 * (ebenfalls multiply). Das Bild bleibt mit Alt-Text im DOM: Es ist Poster,
 * trägt die Beschreibung für Screenreader und tritt bei «Bewegung
 * reduzieren» an die Stelle des Videos – wie bei `.loop-illustration`.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  torn?: 1 | 2 | 3;
  tone?: 'blush' | 'blush-light';
  /** Zweites Papierstück in Safran – höchstens eine Safran-Fläche pro Bildschirm. */
  safran?: boolean;
  /** Bild auf dem ersten Bildschirm: sofort laden statt lazy. */
  eager?: boolean;
  /** Stummes Loop-Video (mp4) zum Bild, gleicher Ausschnitt, weisser Grund. */
  video?: string;
}

const { src, alt, width, height, torn = 1, tone = 'blush', safran = false, eager = false, video } = Astro.props;
---

<figure class="papier-bild" style={`--papier-form: var(--torn-${torn}); aspect-ratio: ${width} / ${height};`}>
  <div class:list={['papier', 'papier-grund', `papier-${tone}`]} aria-hidden="true"></div>
  {safran && <div class="papier papier-safran" aria-hidden="true"></div>}
  {video && (
    <video
      class="papier-video"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      disableremoteplayback
      preload="auto"
      width={width}
      height={height}
      poster={src}
      aria-hidden="true"
    >
      <source src={video} type="video/mp4" />
    </video>
  )}
  <img
    class:list={[{ 'papier-standbild': video }]}
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</figure>

<style>
  .papier-bild {
    position: relative;
    margin: 0;
  }

  .papier {
    position: absolute;
  }

  .papier-grund {
    inset: 4% 2% 8% 6%;
    clip-path: var(--papier-form);
  }

  .papier-blush {
    background: var(--color-blush);
  }

  .papier-blush-light {
    background: var(--color-blush-light);
  }

  .papier-safran {
    right: 4%;
    top: 10%;
    width: 30%;
    aspect-ratio: 1;
    background: var(--color-saffron);
    clip-path: var(--torn-2);
  }

  .papier-bild img,
  .papier-video {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }

  /* Das Video soll wirken wie ein Bild: ohne Bedienelemente, nicht anklickbar. */
  .papier-video {
    pointer-events: none;
  }

  .papier-video::-webkit-media-controls,
  .papier-video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  /* Mit Video liegt das Bild unsichtbar darunter (Alt-Text bleibt lesbar)
     und erscheint erst bei «Bewegung reduzieren». */
  .papier-bild img.papier-standbild {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .papier-video {
      display: none;
    }

    .papier-bild img.papier-standbild {
      position: relative;
      opacity: 1;
    }
  }
</style>

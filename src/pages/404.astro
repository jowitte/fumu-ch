---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Die angeforderte Seite existiert nicht.">
  <section class="container not-found">
    <span class="error-code">404</span>
    <h1>Kein Ergebnis.</h1>
    <p>Die Hypothese war: Diese Seite existiert. Die Daten widerlegen das.</p>
    <a href="/" class="back-link">Zur Startseite</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
  }

  /* Die Zahl gross in Serif und Coral – Coral als Schrift ab 24 px auf Weiss */
  .error-code {
    display: block;
    font-family: var(--font-serif);
    font-size: 120px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-coral);
  }

  .not-found h1 {
    margin: var(--space-md) 0 var(--space-sm);
  }

  .not-found p {
    max-width: var(--page-width);
    margin: 0 0 var(--space-lg);
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-plum-soft);
  }

  .back-link {
    font-size: 15px;
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  @media (max-width: 860px) {
    .error-code {
      font-size: 84px;
    }
  }
</style>

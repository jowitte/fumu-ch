---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Karte from "../../components/Karte.astro";
import PerspektiveZeile from "../../components/PerspektiveZeile.astro";
import { series as seriesRegistry } from "../../data/series";
import { renderInlineLinks } from "../../data/crawler-tracker";
import { isPublished } from "../../lib/published";

const posts = (
  await getCollection("perspektiven", isPublished)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatMonth = (date: Date) => {
  const s = date.toLocaleDateString("de-CH", {
    year: "numeric",
    month: "long",
  });
  return s.charAt(0).toUpperCase() + s.slice(1);
};

const groupedByMonth: { label: string; posts: typeof posts }[] = [];
for (const post of posts) {
  const label = formatMonth(post.data.date);
  const last = groupedByMonth[groupedByMonth.length - 1];
  if (last && last.label === label) {
    last.posts.push(post);
  } else {
    groupedByMonth.push({ label, posts: [post] });
  }
}

// Themen-Block aus der Registry.
const seriesList = Object.entries(seriesRegistry).map(([slug, data]) => ({
  slug,
  ...data,
}));
---

<BaseLayout
  title="Perspektiven"
  description="Analysen und Einordnungen zu Technologie, Medien und digitaler Werbung."
>
  <div class="container seite">
    <h1>Perspektiven</h1>

    <p class="lead">
      Was sich verändert, warum es wichtig ist und was daraus folgt.
      Einordnungen aus der Praxis, wenn Strategie, Technologie und
      Organisation aufeinandertreffen.
    </p>

    <div class="themen">
      {
        seriesList.map((s) => (
          <Karte tone="blush-light" class="thema">
            <h2 class="thema-name">
              <a href={`/perspektiven/themen/${s.slug}/`}>{s.name}</a>
            </h2>
            <p class="thema-text">{s.cardTeaser}</p>
            {s.callout && (
              <p class="thema-text" set:html={renderInlineLinks(s.callout.text)} />
            )}
            <a class="thema-link" href={`/perspektiven/themen/${s.slug}/`}>
              Zum Thema
            </a>
          </Karte>
        ))
      }
    </div>

    {
      posts.length > 0 ? (
        groupedByMonth.map((group) => (
          <section class="monat">
            <h2>{group.label}</h2>
            {group.posts.map((post) => (
              <PerspektiveZeile
                href={`/perspektiven/${post.id}/`}
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                thema={
                  post.data.series && seriesRegistry[post.data.series]
                    ? {
                        name: seriesRegistry[post.data.series].name,
                        href: `/perspektiven/themen/${post.data.series}/`,
                      }
                    : undefined
                }
              />
            ))}
          </section>
        ))
      ) : (
        <section class="monat">
          <h2>In Kürze</h2>
          <p>Neue Perspektiven erscheinen in Kürze.</p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .lead {
    max-width: var(--page-width);
    margin-bottom: var(--space-xl);
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-plum-soft);
  }

  /* Die Themen als Karten in Rosé-hell, ohne Themenfarbe und Icon */
  .themen {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: var(--space-xl);
  }

  .themen :global(.thema) {
    display: flex;
    flex-direction: column;
  }

  .thema-name {
    margin: 0 0 12px;
    font-size: 30px;
    line-height: 1.1;
  }

  .thema-name a {
    color: var(--color-plum);
    text-decoration: none;
  }

  .thema-name a:hover {
    text-decoration: underline;
  }

  .thema-text {
    margin: 0 0 12px;
    font-size: 15.5px;
    color: var(--color-plum-soft);
  }

  .thema-link {
    margin-top: auto;
    padding-top: 8px;
    font-size: 15px;
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .monat {
    margin-bottom: var(--space-xl);
  }

  .monat > h2 {
    margin: 0 0 var(--space-md);
    font-size: 44px;
    line-height: 1.05;
  }

  @media (max-width: 860px) {
    .themen {
      grid-template-columns: minmax(0, 1fr);
    }

    .monat > h2 {
      font-size: 36px;
    }
  }
</style>

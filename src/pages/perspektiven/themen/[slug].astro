---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Karte from '../../../components/Karte.astro';
import PerspektiveZeile from '../../../components/PerspektiveZeile.astro';
import { series as seriesRegistry } from '../../../data/series';
import { renderInlineLinks } from '../../../data/crawler-tracker';
import { isPublished } from '../../../lib/published';

export async function getStaticPaths() {
  return Object.entries(seriesRegistry).map(([slug, data]) => ({
    params: { slug },
    props: { slug, seriesData: data },
  }));
}

const { slug, seriesData } = Astro.props;

// Offener Themenbereich: neueste Perspektive zuerst. Teil-Labels (seriesPart)
// markieren nur die Lesereihenfolge eines erzählten Bogens, nicht die Sortierung.
const parts = (await getCollection('perspektiven', (entry) => isPublished(entry) && entry.data.series === slug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={seriesData.name} description={seriesData.teaser}>
  <div class="container seite">
    <h1>{seriesData.name}</h1>
    <p class="lead">{seriesData.teaser}</p>

    {seriesData.callout && (
      <Karte tone="blush-light" class="hinweis">
        <span class="hinweis-label">{seriesData.callout.label}</span>
        <p class="hinweis-text" set:html={renderInlineLinks(seriesData.callout.text)} />
      </Karte>
    )}

    <section class="liste">
      <h2>Perspektiven</h2>
      {parts.map(post => (
        <PerspektiveZeile
          href={`/perspektiven/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          part={post.data.seriesPart}
        />
      ))}
    </section>

    <a href="/perspektiven/" class="zurueck">&larr; Alle Perspektiven</a>
  </div>
</BaseLayout>

<style>
  .lead {
    max-width: var(--page-width);
    margin-bottom: var(--space-xl);
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-plum-soft);
  }

  .seite :global(.hinweis) {
    max-width: var(--page-width);
    margin-bottom: var(--space-xl);
    padding: 24px 30px 26px;
  }

  .hinweis-label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-plum-soft);
  }

  .hinweis-text {
    margin: 0;
  }

  .liste {
    margin-bottom: var(--space-xl);
  }

  .liste > h2 {
    margin: 0 0 var(--space-md);
    font-size: 44px;
    line-height: 1.05;
  }

  .zurueck {
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .liste > h2 {
      font-size: 36px;
    }
  }
</style>

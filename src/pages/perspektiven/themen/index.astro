---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Karte from "../../../components/Karte.astro";
import { series as seriesRegistry } from "../../../data/series";
import { isPublished } from "../../../lib/published";

const published = await getCollection(
  "perspektiven",
  isPublished,
);

const seriesList = Object.entries(seriesRegistry).map(([slug, data]) => ({
  slug,
  ...data,
  count: published.filter((p) => p.data.series === slug).length,
}));
---

<BaseLayout
  title="Themen"
  description="Themenbereiche der fumu-Perspektiven: KI und Arbeit, AI in der digitalen Werbung, AI in den Medien."
>
  <div class="container seite">
    <h1>Themen</h1>

    <p class="lead">
      Manche Themen tragen weiter als ein einzelner Post. Hier stehen die
      Themenbereiche – jede Perspektive lesbar für sich, zusammen ergeben
      sie das Argument.
    </p>

    <div class="themen">
      {
        seriesList.map((s) => (
          <Karte tone="blush-light" href={`/perspektiven/themen/${s.slug}/`} class="thema">
            <h2 class="thema-name">{s.name}</h2>
            <span class="thema-anzahl">
              {s.count} {s.count === 1 ? "Perspektive" : "Perspektiven"}
            </span>
            <p class="thema-text">{s.teaser}</p>
          </Karte>
        ))
      }
    </div>

    <a href="/perspektiven/" class="zurueck">&larr; Alle Perspektiven</a>
  </div>
</BaseLayout>

<style>
  .lead {
    max-width: var(--page-width);
    margin-bottom: var(--space-xl);
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-plum-soft);
  }

  .themen {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: var(--space-xl);
  }

  .thema-name {
    margin: 0 0 10px;
    font-size: 30px;
    line-height: 1.1;
  }

  .thema-anzahl {
    display: block;
    margin-bottom: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-plum-soft);
  }

  .thema-text {
    margin: 0;
    font-size: 15.5px;
    color: var(--color-plum-soft);
  }

  .zurueck {
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .themen {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

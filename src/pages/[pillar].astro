---
/**
 * Pillar-Seiten: eine Route für alle Einträge der Registry (src/data/pillars.ts).
 * Inhalt kommt aus dem PageContent-Modul der Pillar; der Markdown-Zwilling
 * entsteht aus denselben Daten über [slug].md.ts.
 *
 * Hintergrund: docs/plans/2026-08-21-pillar-seiten.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { jsonLd } from '../lib/json-ld';
import EvansSection from '../components/EvansSection.astro';
import Figure from '../components/Figure.astro';
import PageIntro from '../components/PageIntro.astro';
import { pillarPath, pillars, type Pillar } from '../data/pillars';
import { loadPage } from '../data/pages';
import { headingOf } from '../data/pages/to-markdown';
import { faqPageLd, serviceLd } from '../data/pages/structured-data';

export function getStaticPaths() {
  return pillars.map(pillar => ({ params: { pillar: pillar.slug }, props: { pillar } }));
}

interface Props {
  pillar: Pillar;
}

const { pillar } = Astro.props;
const page = await loadPage(pillar.page);

const url = new URL(pillarPath(pillar), Astro.site).toString();
const structuredData = [serviceLd(page, { url, serviceType: pillar.serviceType }), faqPageLd(page)].filter(Boolean);

const siblings = pillars.filter(p => p.slug !== pillar.slug);
---

<BaseLayout title={page.title} description={page.description}>

  <Fragment slot="head">
    {structuredData.map(data => <script type="application/ld+json" set:html={jsonLd(data)} />)}
  </Fragment>

  <section class="evans-page">
    <div class="container">

      <h1 class="pillar-title">{headingOf(page)}</h1>

      <div class="pillar-lead">
        {page.hero && <Figure figure={page.hero} class="pillar-hero" eager />}
        <PageIntro paragraphs={page.intro} />
      </div>

      {page.sections.map(section => (
        <>
          <hr class="section-divider" />
          <EvansSection section={section} />
        </>
      ))}

      <nav class="pillar-nav" aria-label="Was wir tun">
        <a href="/was-wir-tun/" class="back-link">&larr; Was wir tun</a>
        {siblings.length > 0 && (
          <ul class="siblings">
            {siblings.map(sibling => (
              <li><a href={pillarPath(sibling)}>{sibling.label}</a></li>
            ))}
          </ul>
        )}
      </nav>

    </div>
  </section>

</BaseLayout>

<style>
  /* Der H1 einer Pillar trägt die Suchfrage und ist deshalb länger als die
     übrigen Seitentitel – gleicher Schnitt, kleinerer Grad. */
  .pillar-title {
    font-size: 44px;
    max-width: 880px;
  }

  /* Hero im Lead wie im Magazin: Das Diagramm steht rechts und ragt aus der
     720er-Lesespalte des Leads in den freien Rand des Containers, der Lead
     umfliesst es. flow-root hält den Float im Block, damit die erste
     Section-Linie erst darunter beginnt. Auf dem Handy steht das Bild in
     voller Breite zwischen H1 und Lead. */
  .pillar-lead {
    display: flow-root;
  }

  .pillar-hero {
    float: right;
    width: min(480px, 50%);
    margin: 6px 0 var(--space-xl) var(--space-lg);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--color-coral);
    margin: 0;
  }

  .pillar-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-md) var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-coral);
    margin-bottom: var(--space-xl);
  }

  .back-link,
  .siblings a {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-coral);
  }

  .back-link:hover,
  .siblings a:hover {
    text-decoration: none;
  }

  .siblings {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 768px) {
    .pillar-title {
      font-size: 30px;
    }

    .pillar-hero {
      float: none;
      width: auto;
      margin: 0 0 var(--space-lg) 0;
    }
  }
</style>

---
/**
 * Pillar-Seiten: eine Route für alle Einträge der Registry (src/data/pillars.ts).
 * Inhalt kommt aus dem PageContent-Modul der Pillar; der Markdown-Zwilling
 * entsteht aus denselben Daten über [slug].md.ts.
 *
 * Hintergrund: docs/plans/2026-08-21-pillar-seiten.md
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { jsonLd } from '../lib/json-ld';
import Figure from '../components/Figure.astro';
import Karte from '../components/Karte.astro';
import PageIntro from '../components/PageIntro.astro';
import PerspektivenBlaetter from '../components/PerspektivenBlaetter.astro';
import Sektion from '../components/Sektion.astro';
import type { LinksItem } from '../data/pages/types';
import { pillarPath, pillars, type Pillar } from '../data/pillars';
import { loadPage } from '../data/pages';
import { headingOf } from '../data/pages/to-markdown';
import { faqPageLd, serviceLd } from '../data/pages/structured-data';

export function getStaticPaths() {
  return pillars.map(pillar => ({ params: { pillar: pillar.slug }, props: { pillar } }));
}

interface Props {
  pillar: Pillar;
}

const { pillar } = Astro.props;
const page = await loadPage(pillar.page);

const url = new URL(pillarPath(pillar), Astro.site).toString();
const structuredData = [serviceLd(page, { url, serviceType: pillar.serviceType }), faqPageLd(page)].filter(Boolean);

const siblings = pillars.filter(p => p.slug !== pillar.slug);

// Die verwandten Perspektiven hängt loadPage als letzte Sektion an
// (related.ts). Sie stehen als Blätter im Sockel, nicht in der Spalte.
const related = pillar.page.relatedPerspektiven ? page.sections.at(-1) : undefined;
const sections = related ? page.sections.slice(0, -1) : page.sections;
const relatedEntries = related?.items.find((item): item is LinksItem => item.kind === 'links')?.entries ?? [];
---

<BaseLayout title={page.title} description={page.description}>

  <Fragment slot="head">
    {structuredData.map(data => <script type="application/ld+json" set:html={jsonLd(data)} />)}
  </Fragment>

  <div class="container seite">
    <div class:list={['pillar-kopf', { 'mit-bild': page.hero }]}>
      <h1 class="pillar-titel">{headingOf(page)}</h1>
      {page.hero && (
        <Karte tone="blush-light" class="pillar-hero-karte">
          <Figure figure={page.hero} class="pillar-hero" eager />
        </Karte>
      )}
    </div>
    <PageIntro paragraphs={page.intro} />
    {sections.map(section => <Sektion section={section} />)}
    <nav class="pillar-nav" aria-label="Was wir tun">
      <a href="/was-wir-tun/">&larr; Was wir tun</a>
      {siblings.length > 0 && (
        <ul class="geschwister">
          {siblings.map(sibling => (
            <li><a href={pillarPath(sibling)}>{sibling.label}</a></li>
          ))}
        </ul>
      )}
    </nav>
  </div>

  {related && relatedEntries.length > 0 && (
    <section slot="sockel" class="weiterlesen" aria-labelledby="weiterlesen">
      <div class="sec-head">
        <h2 id="weiterlesen">{related.label}</h2>
      </div>
      <PerspektivenBlaetter
        items={relatedEntries.map(entry => ({ href: entry.href, title: entry.title, text: entry.teaser }))}
      />
    </section>
  )}
</BaseLayout>

<style>
  /* Kopf: Titel links, Diagramm rechts auf Rosé-hell, darunter der Lead.
     Der H1 einer Pillar trägt die Suchfrage und ist deshalb länger als die
     übrigen Seitentitel – gleicher Schnitt, kleinerer Grad. */
  .pillar-kopf {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg) 48px;
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .pillar-kopf.mit-bild {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .pillar-titel {
    margin: var(--space-lg) 0 0;
    font-size: 60px;
    line-height: 1.02;
  }

  .seite :global(.pillar-hero-karte) {
    padding: 24px 24px 18px;
  }

  .seite :global(.pillar-hero) {
    margin: 0;
  }

  .pillar-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-md) var(--space-lg);
    max-width: var(--page-width);
    margin-top: var(--space-xl);
    font-size: 15px;
    font-weight: 600;
  }

  .geschwister {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .geschwister li {
    margin: 0;
  }

  @media (max-width: 860px) {
    .pillar-kopf.mit-bild {
      grid-template-columns: minmax(0, 1fr);
    }

    .pillar-titel {
      font-size: 40px;
    }
  }
</style>

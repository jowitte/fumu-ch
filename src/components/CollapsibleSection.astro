---
// Klappbare Section auf Basis von nativem <details>/<summary> – hält die
// No-Client-JS-Linie des AI-Crawler-Radars, ist crawlbar und nativ
// fokussier-/bedienbar. Titel im Stil einer H2 (Serif, Pflaume), rechts ein
// Plus in Coral, zwischen den Abschnitten eine Haarlinie in Rosé (Redesign 2026-11).
interface Props {
  title: string;
  open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="collapsible" open={open}>
  <summary>
    <span class="title">{title}</span>
    <span class="plus" aria-hidden="true"></span>
  </summary>
  <div class="body">
    <slot />
  </div>
</details>

<style>
  .collapsible {
    padding: 18px 0;
    border-top: 1px solid var(--color-blush);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-plum);
  }

  summary:hover .title {
    color: var(--color-coral);
  }

  /* Plus in Coral, wird offen zum Minus */
  .plus {
    position: relative;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background: var(--color-coral);
    transition: transform 0.15s ease;
  }

  .plus::after {
    transform: rotate(90deg);
  }

  .collapsible[open] > summary .plus::after {
    transform: rotate(0deg);
  }

  .body {
    padding-top: var(--space-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .plus::before,
    .plus::after {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .title {
      font-size: 26px;
    }
  }
</style>

---
import NewsletterSignup from './NewsletterSignup.astro';
import RichText from './RichText.astro';
import type { Section } from '../data/pages/types';

interface Props {
  section: Section;
  /** Label-Spalte mitlaufen lassen (about, was-wir-tun) – auf /kontakt/ steht sie still. */
  sticky?: boolean;
}

const { section, sticky = true } = Astro.props;
---

<div class="evans-section" id={section.id}>
  <div class="evans-label">
    <h2 class:list={[{ sticky }]}>{section.label}</h2>
  </div>
  <div class="evans-content">
    {section.items.map(item => {
      if (item.kind === 'person') {
        return (
          <div class="person" id={item.anchor}>
            <img src={item.image} alt={item.name} class="person-img" loading="lazy" decoding="async" />
            <div class="person-info">
              <h3>{item.name}</h3>
              <span class="evans-tag">{item.tag}</span>
              <p><RichText value={item.body} /></p>
              {item.links.map(l => (
                <a href={l.href} class="linkedin-link" target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a>
              ))}
            </div>
          </div>
        );
      }

      if (item.kind === 'logos') {
        return (
          <div class="logos">
            {item.entries.map(entry => (
              <figure class="logo">
                <img src={entry.image} alt={`Logo ${entry.name}`} loading="lazy" decoding="async" />
                <figcaption>{entry.note}</figcaption>
              </figure>
            ))}
          </div>
        );
      }

      if (item.kind === 'links') {
        return (
          <ul class="links">
            {item.entries.map(entry => (
              <li>
                <a href={entry.href} class="link-entry">
                  <h3>{entry.title}</h3>
                  <p>{entry.teaser}</p>
                </a>
              </li>
            ))}
          </ul>
        );
      }

      if (item.kind === 'quote') {
        return (
          <div class="testimonial">
            <blockquote>
              <p>&laquo;{item.text}&raquo;</p>
              <cite>{item.cite}</cite>
            </blockquote>
          </div>
        );
      }

      // Items ohne Tag und Titel sind Fliesstext-Absätze (Analyse-Teil einer
      // Pillar) und rücken enger zusammen als eigenständige Einträge.
      return (
        <div class:list={['evans-item', { prose: !item.tag && !item.title }]}>
          {item.tag && <span class="evans-tag">{item.tag}</span>}
          {item.title && <h3>{item.title}</h3>}
          <p><RichText value={item.body} /></p>
          {item.cta && (
            <a href={item.cta.href} class="cta-link" target={item.cta.external ? '_blank' : undefined} rel={item.cta.external ? 'noopener' : undefined}>
              {item.cta.label}{item.cta.arrow && <> &rarr;</>}
            </a>
          )}
          {item.component?.name === 'newsletter' && <NewsletterSignup />}
        </div>
      );
    })}
  </div>
</div>

<style>
  .evans-section {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 0;
    margin: var(--space-xl) 0;
  }

  .evans-label {
    padding: 0 var(--space-lg) 0 0;
    display: flex;
    justify-content: flex-end;
  }

  .evans-label h2 {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-coral);
    margin: 0;
  }

  .evans-label h2.sticky {
    position: sticky;
    top: 80px;
  }

  .evans-content {
    border-left: 1px solid var(--color-coral);
    padding: 0 0 0 var(--space-lg);
  }

  .evans-item {
    margin-bottom: var(--space-xl);
  }

  .evans-item:last-child {
    margin-bottom: 0;
  }

  /* Inline-Links aus RichText – Konvention wie .post-body der Perspektiven. */
  .evans-item p :global(a),
  .person-info p :global(a) {
    color: var(--color-coral);
    text-decoration: none;
  }

  .evans-item p :global(a:hover),
  .person-info p :global(a:hover) {
    text-decoration: underline;
  }

  /* Aufeinanderfolgende Absätze lesen sich als ein Text, nicht als Einträge. */
  .evans-item.prose:has(+ .evans-item.prose) {
    margin-bottom: var(--space-md);
  }

  .evans-tag {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .evans-item h3 {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-coral);
    margin: 0 0 var(--space-sm) 0;
    max-width: 600px;
  }

  .evans-item p {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
    max-width: 600px;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 600px;
  }

  .links li + li {
    margin-top: var(--space-lg);
  }

  .link-entry {
    display: block;
    color: inherit;
  }

  .link-entry:hover {
    text-decoration: none;
  }

  .link-entry h3 {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-coral);
    margin: 0 0 var(--space-xs) 0;
  }

  .link-entry:hover h3 {
    text-decoration: underline;
  }

  .link-entry p {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  .cta-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-coral);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-block;
    margin-top: var(--space-md);
  }

  .cta-link:hover {
    text-decoration: none;
  }

  .person {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    margin-bottom: var(--space-xl);
  }

  .person:last-child {
    margin-bottom: 0;
  }

  .person-img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .person-info {
    flex: 1;
  }

  .person-info h3 {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-coral);
    margin: 0 0 var(--space-xs) 0;
  }

  .person-info p {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text);
    margin: var(--space-sm) 0 0 0;
    max-width: 600px;
  }

  .linkedin-link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-coral);
    display: inline-block;
    margin-top: var(--space-sm);
  }

  .linkedin-link:hover {
    text-decoration: none;
  }

  /* Der untere Abstand trennt die Logo-Reihe von einem folgenden Zitat in
     derselben Sektion – ohne ihn liest sich das Testimonial als Bildunterschrift
     des letzten Logos. */
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
    max-width: 640px;
  }

  .logo {
    margin: 0;
  }

  /* Der Breiten-Deckel bestimmt bei langen Wortmarken die Höhe: bei 160px
     landete mediatonic (6:1) auf 26px, während HWZ (2.8:1) die vollen 40px
     bekam. 190px hebt die breiten Marken auf eine vergleichbare Höhe, ohne
     die 200px-Spalte des Grids zu sprengen. */
  .logo img {
    max-height: 40px;
    max-width: 190px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .logo figcaption {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-light);
    margin-top: var(--space-sm);
  }

  .testimonial blockquote {
    margin: 0;
    max-width: 720px;
  }

  .testimonial p {
    font-family: var(--font-sans);
    font-size: 16px;
    font-style: italic;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 var(--space-md) 0;
  }

  .testimonial cite {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    font-style: normal;
    color: var(--color-text-light);
  }

  @media (max-width: 768px) {
    .evans-section {
      grid-template-columns: 1fr;
    }

    .evans-label {
      padding: var(--space-lg) 0 0 0;
    }

    .evans-label h2.sticky {
      position: static;
    }

    .evans-content {
      border-left: none;
      border-top: 1px solid var(--color-coral);
      padding: var(--space-md) 0 0 0;
    }

    .person {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .person-info p {
      max-width: none;
    }

    .logos {
      grid-template-columns: 1fr;
    }
  }
</style>
